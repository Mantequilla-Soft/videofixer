# Server
PORT=3200
LOG_LEVEL=info

# Agent auth — the Hermes agent must send this as X-API-Key
VIDEOFIXER_API_KEY=generate-with-openssl-rand-hex-32

# videofixer's own MongoDB (separate database — never touches embed-jobs/embed-video directly)
MONGODB_URI=mongodb://username:password@host:port
MONGODB_DATABASE=videofixer

# 3speakembed — videofixer proxies these on the agent's behalf
EMBED_BASE_URL=https://embed.3speak.tv
EMBED_ADMIN_PASSWORD=same-as-3speakembed-ADMIN_PASSWORD
EMBED_WEBHOOK_API_KEY=same-as-3speakembed-WEBHOOK_API_KEY

# IPFS
IPFS_GATEWAY_URL=https://ipfs.3speak.tv/ipfs
IPFS_HOTNODE_ENDPOINT=

# Local working storage for downloads/encodes
WORK_DIR=./work
WORK_DIR_SWEEP_MAX_AGE_HOURS=6

# Processing
MAX_CONCURRENT_JOBS=1
