{
  "name": "videofixer",
  "version": "1.0.0",
  "description": "Autonomous video repair API for the 3Speak encoding pipeline — probes, diagnoses, re-encodes, and finalizes broken videos on behalf of an AI agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "vitest run"
  },
  "keywords": [
    "3speak",
    "video",
    "encoder",
    "ffmpeg",
    "ipfs",
    "repair"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mantequilla-Soft/videofixer.git"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.4",
    "mongodb": "^6.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.10.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.5"
  }
}
