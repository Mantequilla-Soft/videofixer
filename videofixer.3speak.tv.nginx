# videofixer — internal agent-facing repair API, proxied to the pm2-managed
# Node process on 127.0.0.1:3200.
#
# /encode requests run synchronously for the full download+ffmpeg+upload
# duration (can be several minutes for premium/multi-quality jobs) — the
# generous proxy_read_timeout/proxy_send_timeout below exist specifically
# for that; without them nginx will 504 an /encode call that's still
# legitimately running.
server {
    listen 80;
    listen [::]:80;
    server_name videofixer.3speak.tv;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /encode is a long synchronous request — see note above.
        proxy_connect_timeout 60s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;

        # Optional defense-in-depth: every route already requires
        # X-API-Key, but if the Hermes agent always calls from a known,
        # stable IP, uncomment and restrict to it here too.
        # allow 203.0.113.10;
        # deny all;
    }
}

# After DNS for videofixer.3speak.tv points at this server, run:
#   sudo certbot --nginx -d videofixer.3speak.tv
# Certbot will rewrite this file in place to add the HTTPS server block,
# the SSL certificate directives, and an HTTP -> HTTPS redirect — the same
# way it did for the other *.3speak.tv sites on this box. Don't hand-add
# ssl_certificate lines yourself; let certbot do it.
